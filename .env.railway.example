# Set these in the Railway web service; do not copy local .env into the image.
ENVIRONMENT=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Replace both origins with your generated HTTPS Railway domain (the same value).
FRONTEND_URL=https://YOUR-SERVICE.up.railway.app
BACKEND_URL=https://YOUR-SERVICE.up.railway.app
CORS_ORIGINS=["https://YOUR-SERVICE.up.railway.app"]
COOKIE_SECURE=true
STATIC_DIR=/app/static
CLIENT_IP_SOURCE=railway
CACHE_TTL_SECONDS=120
RATE_LIMIT_PER_MINUTE=30
# OPENDOTA_API_KEY is optional and must remain server-side.
